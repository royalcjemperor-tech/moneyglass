# Generate real values with: npm run secrets
NODE_ENV=production
PORT=3000
DATA_DIR=/app/data
SESSION_SECRET=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LOOKUP_SECRET=replace-with-another-long-random-secret
SESSION_TTL_DAYS=7
ALLOW_SIGNUP=true
TRUST_PROXY=1
COOKIE_SECURE=auto
# Optional: connect to your own Ollama instance for local-model answers.
# Leave blank to use the built-in zero-cost private insights engine.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
CLOUDFLARE_TUNNEL_TOKEN=
